# Copy this file to vault.yml, fill in real values, then encrypt:
#   ansible-vault encrypt ansible/group_vars/media_servers/vault.yml
#
# To run the playbook with the vault:
#   ansible-playbook -i ansible/inventory.yml ansible/playbook.yml --ask-vault-pass

vault_wireguard_private_key: REPLACE_ME
vault_wireguard_addresses: REPLACE_ME          # e.g. 10.14.0.2/32
vault_firewall_outbound_subnets: REPLACE_ME    # e.g. 192.168.1.0/24

vault_jellyfin_api_key: REPLACE_ME
vault_seerr_api_key: REPLACE_ME
vault_radarr_api_key: REPLACE_ME
vault_sonarr_api_key: REPLACE_ME
vault_prowlarr_api_key: REPLACE_ME

vault_sabnzbd_api_key: REPLACE_ME
vault_sabnzbd_nzb_key: REPLACE_ME
vault_sabnzbd_server_username: REPLACE_ME
vault_sabnzbd_server_password: REPLACE_ME

vault_qbittorrent_password_hash: REPLACE_ME    # value of WebUI\Password_PBKDF2 from qBittorrent.conf (without surrounding quotes)

vault_seerr_client_id: REPLACE_ME             # clientId UUID from seerr/settings.json
vault_seerr_session_secret: REPLACE_ME        # sessionSecret from seerr/settings.json
vault_seerr_vapid_private: REPLACE_ME         # vapidPrivate from seerr/settings.json
vault_seerr_vapid_public: REPLACE_ME          # vapidPublic from seerr/settings.json
vault_seerr_jellyfin_api_key: REPLACE_ME      # jellyfin.apiKey from seerr/settings.json (distinct from vault_jellyfin_api_key)

vault_bazarr_api_key: REPLACE_ME              # auth.apikey from bazarr/config/config.yaml
vault_bazarr_flask_secret_key: REPLACE_ME     # general.flask_secret_key from bazarr/config/config.yaml
vault_bazarr_addic7ed_username: REPLACE_ME
vault_bazarr_addic7ed_password: REPLACE_ME
vault_bazarr_opensubtitles_username: REPLACE_ME
vault_bazarr_opensubtitles_password: REPLACE_ME

vault_pihole_webpassword: REPLACE_ME

vault_grafana_cloud_prometheus_url: REPLACE_ME      # Grafana Cloud → your stack → Details → Prometheus → Remote Write Endpoint
vault_grafana_cloud_prometheus_username: REPLACE_ME # Numeric username shown on the same page
vault_grafana_cloud_loki_url: REPLACE_ME            # Grafana Cloud → your stack → Details → Loki → URL (append /loki/api/v1/push)
vault_grafana_cloud_loki_username: REPLACE_ME       # Numeric username shown on the same page
vault_grafana_cloud_api_key: REPLACE_ME             # Service account token — Administration → Service Accounts → Add token

vault_romm_db_password: REPLACE_ME
vault_romm_db_root_password: REPLACE_ME
vault_romm_auth_secret_key: REPLACE_ME    # random string, e.g.: openssl rand -hex 32

# Optional — RomM metadata sources (all commented out until you have credentials)
# IGDB: register a Twitch app at dev.twitch.tv, enable IGDB API product
# vault_igdb_client_id: REPLACE_ME
# vault_igdb_client_secret: REPLACE_ME
# MobyGames: request API key at mobygames.com/info/api/
# vault_mobygames_api_key: REPLACE_ME
# ScreenScraper: account credentials from screenscraper.fr
# vault_screenscraper_user: REPLACE_ME
# vault_screenscraper_password: REPLACE_ME
# RetroAchievements: API key from retroachievements.org/settings
# vault_retroachievements_api_key: REPLACE_ME
# SteamGridDB: API key from steamgriddb.com (profile → preferences → API)
# vault_steamgriddb_api_key: REPLACE_ME

vault_tailscale_authkey: REPLACE_ME    # Tailscale admin console → Settings → Keys → Generate auth key

# OneDrive sync — base64 of the refresh_token from the machine where the
# onedrive client was last authorized. Generate paste-safe with:
#   base64 -w0 ~/.config/onedrive/refresh_token
vault_onedrive_refresh_token_b64: REPLACE_ME

# Uncomment if enabling Immich
# vault_immich_db_password: REPLACE_ME
