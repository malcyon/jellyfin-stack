{# Managed by Ansible — roles/windows-vm #}
<network>
  <name>{{ winvm_network_name }}</name>
  <!-- Derived from the name rather than left to libvirt: net-define
       refuses to redefine an existing network unless the UUID matches,
       so a generated one would make every re-run after the first fail. -->
  <uuid>{{ (winvm_network_name ~ '-winvm-net') | to_uuid }}</uuid>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='{{ winvm_bridge }}' stp='on' delay='0'/>

  <!-- Neither DNS nor DHCP, which means libvirt starts no dnsmasq for this
       network at all. It cannot: Pi-hole runs with network_mode: host and is
       the LAN's DNS *and* DHCP server, holding 0.0.0.0:53 and 0.0.0.0:67. A
       DHCP server always binds the wildcard address — there is no way to scope
       it to one interface — so a second one on this host is impossible.
       The guest is given a static address by autounattend.xml instead. -->
  <dns enable='no'/>

  <ip address='{{ winvm_net_gateway }}' netmask='{{ winvm_net_netmask }}'/>
</network>
