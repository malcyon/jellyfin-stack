.env
ansible/group_vars/media_servers/vault.yml

# Ignore everything in app dirs by default
gluetun/**
jellyfin/**
qbittorrent/**
radarr/**
sonarr/**
lidarr/**
prowlarr/**
seerr/**
sabnzbd/**
bazarr/**
nginx/**
pihole/**
!pihole/
!pihole/etc-dnsmasq.d/
!pihole/etc-dnsmasq.d/02-local-reservations.conf
degoog/**
immich/**
onedrive/**
freshrss/**
romm/**
beets/**
homepage/logs/**
kiwix/**

# Allow clean qBittorrent files
!qbittorrent/
!qbittorrent/qBittorrent/
!qbittorrent/qBittorrent/categories.json

# Allow tracked Beets config (library.db and logs stay ignored)
!beets/
!beets/config.yaml

# Jellyfin runtime config is managed by Jellyfin itself — not tracked in git
!jellyfin/
